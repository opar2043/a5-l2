generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------
// Auth Models (BetterAuth)
// -----------------------------
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]

  // Portal relations
  reviews       Review[]
  comments      Comment[]
  watchlist     Watchlist[]
  purchases     Purchase[]
  reviewLikes   ReviewLike[]
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expires   DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id        String   @id @default(cuid())
  userId    String
  provider  String
  providerAccountId String
  accessToken String?
  refreshToken String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

}

// -----------------------------
// Main Portal Models
// -----------------------------
model Movie {
  id                 String    @id @default(cuid())
  title              String
  synopsis           String?
  releaseYear        Int?
  director           String?
  cast               String?          // comma-separated names
  streamingPlatforms String[]         // ["Netflix", "Disney+"]
  pricing            Pricing  @default(FREE)
  posterUrl          String?
  trailerUrl         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  reviews    Review[]
  watchlists Watchlist[]
  purchases  Purchase[]
    @@map("movie")
}

model Review {
  id         String    @id @default(cuid())
  userId     String
  movieId    String
  rating     Int       @db.SmallInt
  content    String?
  spoiler    Boolean   @default(false)
  isApproved Boolean   @default(false)
  likesCount Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  movie Movie @relation(fields: [movieId], references: [id])
  comments Comment[]
  reviewLikes ReviewLike[]
    @@map("review")
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  reviewId  String
  parentId  String?  // for nested comments
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  review Review @relation(fields: [reviewId], references: [id])
  parent Comment? @relation("CommentToComment", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentToComment")
    @@map("comment")
}

model Watchlist {
  id      String @id @default(cuid())
  userId  String
  movieId String
  addedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  movie Movie @relation(fields: [movieId], references: [id])

  @@unique([userId, movieId])
    @@map("watchlist")
}

model Purchase {
  id          String       @id @default(cuid())
  userId      String
  movieId     String
  purchaseType PurchaseType
  price       Float
  expiresAt   DateTime?   // for rentals
  createdAt   DateTime    @default(now())

  user  User  @relation(fields: [userId], references: [id])
  movie Movie @relation(fields: [movieId], references: [id])
    @@map("purchase")
}

model ReviewLike {
  id       String   @id @default(cuid())
  userId   String
  reviewId String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  review Review @relation(fields: [reviewId], references: [id])

  @@unique([userId, reviewId])
    @@map("reviewlike")
}

// -----------------------------
// Enums
// -----------------------------
enum Role {
  USER
  ADMIN
}

enum Pricing {
  FREE
  PREMIUM
}

enum PurchaseType {
  RENT
  BUY
}